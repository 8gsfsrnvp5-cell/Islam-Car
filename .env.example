# Образец настроек для docker compose. Скопируйте в .env и задайте свои значения.
# Файл .env не попадает в git. Никогда не коммитьте реальные пароли и ключи.

# Пароль базы данных PostgreSQL (длинный случайный)
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# development | production. В production отключается документация API (/api/docs)
ENVIRONMENT=development

# Адреса сайтов, с которых принимаются изменяющие запросы (через запятую)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# true — только при работе по HTTPS
COOKIE_SECURE=false

COMPANY_TIMEZONE=Europe/Moscow

# Адрес клиентского сайта — админка использует его в ссылках для клиентов
PUBLIC_CLIENT_URL=http://localhost:3000

# Второй фактор для владельца: по умолчанию обязателен при ENVIRONMENT=production
REQUIRE_OWNER_2FA=

# Каналы уведомлений. Пусто — канал не подключён, сообщения не отправляются.
# SMS — только через официального поставщика рассылок (подключается отдельной задачей).
# EMAIL_PROVIDER=smtp + параметры SMTP. Значение "log" — тестовый режим (запрещён в production).
SMS_PROVIDER=
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Резервные копии (каталог /backups внутри контейнеров — том backups)
BACKUP_RETENTION_DAYS=30
# Отдельная пустая база для еженедельной проверки полного восстановления (необязательно)
BACKUP_VERIFY_DATABASE_URL=
