# Образец для запуска API без Docker. Скопируйте в services/api/.env (файл не попадает в git).
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://islamcar:ВАШ_ПАРОЛЬ@localhost:5432/islamcar
STORAGE_DIR=storage
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_SECURE=false
COMPANY_TIMEZONE=Europe/Moscow
